{
  "name": "mountebank-studio",
  "version": "0.1.3",
  "description": "A visual console for Mountebank: imposters, stubs, responses and captured traffic, without hand-writing JSON. Unofficial — not affiliated with the mountebank project.",
  "license": "Apache-2.0",
  "author": "Gökhan İbrikçi <gokhanibrikci@gmail.com>",
  "type": "module",
  "bin": {
    "mountebank-studio": "server/index.mjs"
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "LICENSE",
    "NOTICE",
    "COVERAGE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mountebank",
    "mock",
    "mock-server",
    "api-mocking",
    "service-virtualization",
    "test-doubles",
    "stub",
    "imposter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokhanibrikci/mountebank-studio.git"
  },
  "bugs": {
    "url": "https://github.com/gokhanibrikci/mountebank-studio/issues"
  },
  "homepage": "https://github.com/gokhanibrikci/mountebank-studio#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:types": "tsc --noEmit -p tsconfig.app.json",
    "tests": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "start": "node server/index.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "mountebank": "^2.9.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axios": "^1.19.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  }
}
